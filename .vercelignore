# =====================================================================
# .vercelignore
# Vercel deploys ONLY the React frontend from this repository.
# The FastAPI backend is deployed separately on Railway:
#   https://foodconnect-ai.up.railway.app
#
# Everything below is excluded from the upload, which is what fixes:
#   "Total bundle size (674.67 MB) exceeds the maximum function size (500 MB)"
# =====================================================================

# ---- Python backend (deployed on Railway, never on Vercel) ----
backend/
*.py
*.pyc

# ---- Python virtual environments (~747 MB locally) ----
.venv/
.venv
backend/.venv/
backend/.venv
backend/.venv/**
venv/
venv
backend/venv/
backend/venv
env/
env
backend/env/
backend/env

# ---- Python caches / build artifacts ----
__pycache__/
**/__pycache__/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.whl

# ---- Node dependencies (reinstalled by Vercel) ----
node_modules/
**/node_modules/

# ---- Local build output (regenerated during the Vercel build) ----
# NOTE: frontend/dist is NOT listed here because it is the outputDirectory
# and must be uploaded after the build completes. The local dist/ is
# regenerated by "npm run build" anyway.
.vite/
**/.vite/
.cache/
*.tsbuildinfo

# ---- Vercel CLI local state ----
.vercel/
**/.vercel/

# ---- Secrets / local env files (use Vercel Environment Variables) ----
# Vercel reads env vars from Project Settings, not from committed .env files.
# Negations MUST come after the matching rules (gitignore = last match wins).
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# ---- Git / editor / OS noise ----
.git/
.gitignore
.gitattributes
.DS_Store
Thumbs.db
*.log

# ---- Datasets and other large non-frontend assets ----
*.csv
*.parquet
*.db
*.sqlite
*.sqlite3
*.pkl
*.pt
*.onnx
*.bin
*.h5
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.mp4
*.mov

# ---- Documentation (not needed at runtime) ----
*.md
!README.md
frontend/README.md
backend/*.md

# ---- Backend data files (served from Railway) ----
backend/data/

